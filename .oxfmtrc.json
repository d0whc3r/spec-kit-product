{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    ".specify/**",
    ".claude/**",
    ".vscode/**",
    ".github/agents/**",
    ".github/agents/**",
    ".agents/**",
    "specs/**",
    "node_modules/**",
    "dist/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
