{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash .github/scripts/semantic-release-prepare.sh ${nextRelease.version}",
        "publishCmd": "bash .github/scripts/submit-catalog-update.sh ${nextRelease.version} ${nextRelease.type} ${nextRelease.gitTag}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "extension.yml",
          "catalog.json",
          "README.md",
          "docs/Getting-Started.md"
        ],
        "message": "chore(release): catalog v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/product-*.zip",
            "label": "product-${nextRelease.version}.zip"
          }
        ]
      }
    ]
  ]
}
